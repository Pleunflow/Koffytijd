# Kopieer naar .env (doet `pnpm db:up` automatisch als .env nog niet bestaat).

# Postgres uit docker-compose.yml. Later: de Neon-connection string.
DATABASE_URL=postgres://koffy:koffy@localhost:5432/koffytijd

# Database voor `pnpm test`. Wordt bij elke testrun leeggemaakt.
TEST_DATABASE_URL=postgres://koffy:koffy@localhost:5432/koffytijd_test

# Inloggen. Nu alleen `local` (kantoor + naam kiezen). Later: Google SSO.
AUTH_MODE=local

# Sleutel waarmee de login-cookie ondertekend wordt. Minstens 32 tekens.
# Genereer met: openssl rand -hex 32   (doet `pnpm db:up` voor je als .env nog niet bestaat)
AUTH_SECRET=

# Merk: toppy | heuts
BRAND=toppy

# Alleen nodig als het IP-adres van de laptop niet in 192.168.x.x, 10.x.x.x of
# 172.x.x.x valt: extra hostnames/IP's voor de dev-server, komma-gescheiden.
DEV_ORIGINS=
